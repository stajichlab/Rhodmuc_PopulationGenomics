// Root Nextflow config for running nf-core/sarek on the UCR HPCC (SLURM)
// against the custom Rhodotorula mucilaginosa DH4148 reference genome.

manifest {
    name        = 'Rhodotorula_mucilaginosa_DH4148_ref'
    description = 'nf-core/sarek germline variant calling vs GCA_058775505.1 (DH4148)'
}

executor {
    name            = 'slurm'
    queueSize       = 100
    submitRateLimit = '10/1min'
}

singularity {
    enabled      = true
    autoMounts   = true
    cacheDir     = '/bigdata/stajichlab/shared/lib/singularity_cache'
    envWhitelist = 'SCRATCH'
    // envWhitelist restricts HOME from being passed into the container, so
    // Java tools (e.g. FastQC's fontconfig/imageio cache) fall back to an
    // unwritable default $HOME inside the read-only image. Point HOME at the
    // task's own work dir instead, which is always writable.
    // SINGULARITYENV_TMPDIR carries the host TMPDIR (set to node-local
    // $SCRATCH below) through to the container, since /tmp is bind-mounted
    // in by default and can fill up independently per compute node.
    runOptions   = '--home "$PWD"'
}

process {
    executor       = 'slurm'
    cache          = 'lenient'
    shell          = ['/bin/bash', '-l']
    clusterOptions = '-N 1 -n 1'
    // Node-local $SCRATCH (not shared /bigdata) is fast NVMe pre-created per
    // SLURM job; point TMPDIR there so heredocs/mktemp don't depend on
    // whatever /tmp happens to have free on the node we land on.
    // Java's ImageIO (used by FastQC's HTML report icon caching) does NOT
    // consult TMPDIR/SINGULARITYENV_TMPDIR - it resolves its own temp dir via
    // the JVM, so it silently falls back to the container's internal /tmp and
    // fails with "No space left on device" if that fills up. _JAVA_OPTIONS /
    // JAVA_TOOL_OPTIONS are read by every JVM at startup regardless of entry
    // point, so force -Djava.io.tmpdir explicitly rather than relying on
    // TMPDIR propagation alone.
    beforeScript   = 'module load singularity; export TMPDIR="${SCRATCH:?}"; export SINGULARITYENV_TMPDIR="${SCRATCH:?}"; export SINGULARITYENV__JAVA_OPTIONS="-Djava.io.tmpdir=${SCRATCH:?}"; export SINGULARITYENV_JAVA_TOOL_OPTIONS="-Djava.io.tmpdir=${SCRATCH:?}"'

    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 2

    // Belt-and-suspenders: bind $SCRATCH over the container's /tmp directly
    // for FASTQC, since ImageIO's fallback isn't guaranteed to honor the JVM
    // options above for every code path.
    // NOTE: must stay single-quoted/literal ($SCRATCH, no ${} interpolation).
    // Each FASTQC task runs as its OWN SLURM sub-job with its own node-local
    // $SCRATCH; a Groovy closure using System.getenv('SCRATCH') would resolve
    // in the Nextflow *head* job's environment instead (wrong job id/node),
    // causing "mount source ... doesn't exist". Leaving it literal defers
    // expansion to bash inside that task's own .command.run at its own
    // runtime, in its own environment - the same fix class as never using
    // BASH_SOURCE[0]-based path resolution in scripts destined for SLURM.
    withName: 'FASTQC' {
        containerOptions = '-B $SCRATCH:/tmp'
    }

    withLabel: 'process_low' {
        queue  = 'short'
        cpus   = { 2 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = '2h'
    }
    withLabel: 'process_medium' {
        queue  = 'epyc'
        cpus   = { 6 * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = '24h'
    }
    withLabel: 'process_high' {
        queue  = 'epyc'
        cpus   = { 12 * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { task.attempt == 1 ? '24h' : '72h' }
    }
    withLabel: 'process_high_memory' {
        queue  = 'highmem'
        cpus   = { 12 * task.attempt }
        memory = { 128.GB * task.attempt }
        time   = '72h'
    }
}

profiles {
    sarek {
        includeConfig 'conf/profile_sarek.config'
    }
}

// Keep pipeline execution reports scoped so re-runs don't clobber history
timeline.overwrite = true
report.overwrite   = true
trace.overwrite    = true
dag.overwrite      = true
