// Profile for nf-core/sarek germline variant calling
// against the custom DH4148 (GCA_058775505.1) reference.
// Activate with: -profile sarek

params {
    input  = "${launchDir}/samplesheet.csv"
    outdir = "${launchDir}/results"

    // Custom (non-iGenomes) reference — build indices/dict once, cache in igenomes_base-style dir
    genome        = null
    fasta         = "${launchDir}/refgenome/GCA_058775505.1_UCR_RmucDH4148_1.0_genomic.fna"
    gtf           = "${launchDir}/refgenome/GCA_058775505.1_UCR_RmucDH4148_1.0_genomic.gtf"
    save_reference = true

    // No dbSNP/known-sites/germline-resource available for this non-model organism
    dbsnp             = null
    known_indels      = null
    known_snps        = null
    germline_resource = null
    intervals         = null
    wes               = false

    // No variant calling in Sarek at all: this project's germline calling is
    // ploidy-aware per-strain (nf_genotype_population), which Sarek cannot
    // do. Sarek is used only for QC/alignment/dedup through CRAM output.
    // (Sarek's only germline joint-filtering path is VQSR, which requires a
    // known-sites truth resource we don't have for this organism - verified
    // by reading its 3.9.0 source; there is no hard-filter fallback in Sarek.)
    tools          = ''
    joint_germline = false
    step           = 'mapping'
    aligner        = 'bwa-mem2'

    igenomes_ignore = true
}

workDir = "${launchDir}/work/sarek"

timeline.file = "${launchDir}/logs/sarek_timeline.html"
report.file   = "${launchDir}/logs/sarek_report.html"
trace.file    = "${launchDir}/logs/sarek_trace.txt"
dag.file      = "${launchDir}/logs/sarek_dag.html"
